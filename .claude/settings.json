{
  "defaultMode": "acceptEdits",
  "includeCoAuthoredBy": false,
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "enabledMcpjsonServers": [
    "supabase"
  ],
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git pull)",
      "Bash(git fetch *)",
      "Bash(git push *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(mkdir *)",
      "Bash(mkdir -p *)",
      "Bash(tar *)",
      "Bash(zip *)",
      "Bash(rsync *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm ci)",
      "Bash(npm run lint*)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip install *)",
      "Bash(npx expo *)",
      "Bash(npx expo start *)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(ffprobe *)",
      "Bash(sips *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(wc -l *)",
      "Bash(du -sh *)",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:reactnative.dev)",
      "WebFetch(domain:reactjs.org)",
      "mcp__supabase__get_publishable_keys",
      "mcp__supabase__get_project_url",
      "mcp__supabase__list_edge_functions",
      "mcp__supabase__list_migrations",
      "mcp__supabase__deploy_edge_function",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_projects",
      "mcp__supabase__generate_typescript_types",
      "mcp__supabase__get_logs"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(npx eas *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "mcp__supabase__execute_sql",
      "mcp__supabase__apply_migration",
      "mcp__supabase__reset_branch",
      "mcp__supabase__delete_project"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)",
      "Bash(:(){ :|:& };:)",
      "Bash(shutdown *)",
      "Bash(reboot)",
      "Bash(mkfs*)",
      "Bash(dd if=* of=/dev/*)",
      "Read(./.env*)",
      "Read(**/*.pem)",
      "Read(**/*secret*)"
    ]
  }
}